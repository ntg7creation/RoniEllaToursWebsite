{
  "name": "roniella-tours-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "config:check": "node --env-file=.env --import tsx scripts/check-config.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": { "zod": "^4.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "~5.9.3" }
}
