# Local simulation only. No messages sent or stored.
NODE_ENV=development
EMAIL_PROVIDER=local
ABUSE_MODE=disabled
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
# Production: EMAIL_PROVIDER=resend and ABUSE_MODE=managed
RESEND_API_KEY=
# Bare addresses, one recipient only. Verify the sender domain with Resend.
EMAIL_FROM=
EMAIL_TO=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random server-only secret, at least 32 characters, for hashing email throttle keys.
RATE_HASH_SECRET=
# Use a distinct namespace per environment, shared by all instances.
RATE_NAMESPACE=roniella-dev
RATE_WINDOW_SECONDS=600
RATE_GLOBAL_LIMIT=100
RATE_EMAIL_LIMIT=5
