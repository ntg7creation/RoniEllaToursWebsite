    {
      "pageId": "page-8b705230-ab4d-496c-8e06-f2bcc6254ac6",
      "publicPath": "/tours/china-may-2027/",
      "pageType": "tour",
      "sourceTextNodes": 308,
      "preservedTextNodes": 308,
      "missingText": [],
      "sourceH1": [
        "סין – צ’ונג גואה, האימפריה באמצע העולם – מאי 2027"
      ],
      "itinerarySections": [
        {
          "heading": "היום הראשון למסע: ממריאים אל ארץ החלום",
          "start": 19,
          "end": 20
        },
        {
          "heading": "היום השני למסע: סודות ספר התמורות, פילוסופיה חקוקה באבן",
          "start": 21,
          "end": 23
        },
        {
          "heading": "היום השלישי למסע: קונפוציוס, לאמה, פעמון, ופלאים ארכיטקטוניים",
          "start": 24,
          "end": 25
        },
        {
          "heading": "היום הרביעי למסע: החומה הסינית הגדולה, זאבים מייללים בחשכה, בנו התשיעי של מלך הדרקונים וקברו של קיסר",
          "start": 26,
          "end": 28
        },
        {
          "heading": "היום החמישי למסע: אדם מול טנק, דגם ענק ומרגש, מאוזוליאום ועיר אסורה",
          "start": 29,
          "end": 30
        },
        {
          "heading": "היום השישי למסע: ביקורים מלכותיים, מסדרון באורך למעלה מ-700 מטרים, פעמון אדיר, הוטונג ורחוב חנויות מסורתי המתפתל לאינסוף",
          "start": 31,
          "end": 32
        },
        {
          "heading": "היום השביעי למסע: בין שתי ערי בירה: מבייג'ינג לסיאן",
          "start": 33,
          "end": 34
        },
        {
          "heading": "היום השמיני למסע: הצדעה לאלפי חיילי טרהקוטה, קיסר עם\nדגים מלוחים, דגמי מרכבות יפהפיים ודמעות באופרה סינית אמיתית",
          "start": 35,
          "end": 36
        },
        {
          "heading": "היום התשיעי למסע: פסלי זהב ענקיים, מסעו של נזיר להודו, ומסגד סיני בלתי שגרתי",
          "start": 37,
          "end": 38
        },
        {
          "heading": "היום העשירי למסע: אתנחתא נפלאה של טבע פראי, נופים פראיים ומערת חלון",
          "start": 39,
          "end": 40
        },
        {
          "heading": "היום האחד עשר למסע: לרחף על גשר זכוכית מעל התהום, מפלי מים סואנים, ציוץ ציפורים, שייט ושבילים ירוקים מתפתלים",
          "start": 41,
          "end": 42
        },
        {
          "heading": "היום השנים עשר למסע: שני נהרות וארבעה אגמים בלילה קסום",
          "start": 43,
          "end": 44
        },
        {
          "heading": "היום השלושה עשר למסע: מערת נטיפים יפהפיה וטראסות אורז קסומות",
          "start": 45,
          "end": 46
        },
        {
          "heading": "היום הארבעה עשר למסע: נופי יאנגשו.",
          "start": 47,
          "end": 48
        },
        {
          "heading": "היום החמישה עשר למסע: ברוכים הבאים לתל אביב של סין",
          "start": 49,
          "end": 50
        },
        {
          "heading": "היום השישה עשר למסע: גני איואניו הקסומים והמורשת היהודית של שנגחאי",
          "start": 51,
          "end": 52
        },
        {
          "heading": "היום השבעה עשר למסע: ארוחת ערב חגיגית ו\"צט יה (להתראות) צ'ונג גואה\"! - בחזרה מארץ החלום",
          "start": 53,
          "end": 55
        }
      ],
      "termsSections": [
