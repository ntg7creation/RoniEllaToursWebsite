# Optional, server-only configuration. Leave empty while designing the site.
# Never prefix these with VITE_ or commit actual values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The API resource for the verified business, not the CID in its public URL.
GOOGLE_BUSINESS_LOCATION=
# Google Cloud Translation Basic v2. Server-side only; never use a VITE_ prefix.
GOOGLE_TRANSLATE_API_KEY=
