# Copy to deploy/.env and supply real values. Never commit the filled-in file.
DEPLOYMENT_ENV=preview
CONTENT_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_SECRET
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKEND_API_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_VALUE
SITE_ORIGIN=https://preview.example.com
# Used by preflight and when running SSR directly; Compose wires this same private address.
BACKEND_ORIGIN=http://backend:3001
ALLOW_INDEXING=false
CONTENT_CACHE_MS=30000
SUPABASE_TIMEOUT_MS=8000
CONTENT_TIMEOUT_MS=12000
WEB_PORT=3000
RELEASE_TAG=first-preview
# Backend-only direct callback email. Inquiry details are not stored in Supabase or local files.
GMAIL_USER=roniellatours@gmail.com
# GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHARACTER_GOOGLE_APP_PASSWORD
CALLBACK_EMAIL_TO=roniellatours@gmail.com
# Only used with compose.tls.yml. SITE_HOST must match SITE_ORIGIN's hostname.
SITE_HOST=preview.example.com
TLS_EMAIL=YOUR_EMAIL
