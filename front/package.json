{
  "name": "@roniella/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 5173",
