    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@remix-run/node-fetch-server": "0.14.2",
    "@roniella/shared": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "vite": "8.3.5"
  }
}
